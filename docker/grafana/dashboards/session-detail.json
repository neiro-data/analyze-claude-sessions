{
  "uid": "acp-session-detail",
  "title": "Session Detail",
  "schemaVersion": 39,
  "version": 5,
  "editable": false,
  "timezone": "utc",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "session_id",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "claude-analytics-pg"
        },
        "query": "SELECT session_id::text AS __value, session_id::text AS __text FROM claude.v_session_token_summary ORDER BY first_event_at DESC",
        "refresh": 1,
        "sort": 0,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "claude-analytics-pg"
        },
        "query": "SELECT DISTINCT model AS __text, model AS __value FROM claude.api_calls WHERE session_id = ${session_id:sqlstring} AND model IS NOT NULL ORDER BY model",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 14,
      "title": "",
      "type": "stat",
      "transparent": true,
      "datasource": {
        "type": "postgres",
        "uid": "claude-analytics-pg"
      },
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "session_title",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT coalesce(nullif(ai_title, ''), session_id::text) AS session_title FROM claude.v_session_token_summary WHERE session_id = ${session_id:sqlstring}"
        }
      ]
    },
    {
      "id": 1,
      "title": "Total tokens",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "claude-analytics-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1000000
              },
              {
                "color": "orange",
                "value": 5000000
              },
              {
                "color": "red",
                "value": 10000000
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT coalesce(sum(total_input_tokens),0) + coalesce(sum(output_tokens),0) AS total_tokens FROM claude.v_call_detail WHERE session_id = ${session_id:sqlstring} AND ('${model:csv}' = '' OR model = ANY(string_to_array('${model:csv}', ',')))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Cache-read %",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "claude-analytics-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT round(sum(cache_read_tokens)::numeric / NULLIF(sum(total_input_tokens),0) * 100, 2) AS cache_read_pct FROM claude.v_call_detail WHERE session_id = ${session_id:sqlstring} AND ('${model:csv}' = '' OR model = ANY(string_to_array('${model:csv}', ',')))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Duration (s)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "claude-analytics-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 3
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT duration_seconds FROM claude.v_session_token_summary WHERE session_id = ${session_id:sqlstring}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Model(s)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "claude-analytics-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 3
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "models",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT array_to_string(models, ', ') AS models FROM claude.v_session_token_summary WHERE session_id = ${session_id:sqlstring}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Subagents / transcripts",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "claude-analytics-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT subagent_count, transcript_count FROM claude.v_session_token_summary WHERE session_id = ${session_id:sqlstring}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Avg interval between calls (s)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "claude-analytics-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT round(avg(delta_seconds), 1) AS avg_interval_seconds FROM claude.v_call_detail WHERE session_id = ${session_id:sqlstring} AND call_index > 1 AND ('${model:csv}' = '' OR model = ANY(string_to_array('${model:csv}', ',')))"
        }
      ]
    },
    {
      "id": 6,
      "title": "Call timeline (tokens per call, by iteration)",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "claude-analytics-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "model",
            "rowField": "call_index",
            "valueField": "tokens",
            "emptyValue": "zero"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "call_index\\model": "call_index"
            },
            "excludeByName": {},
            "indexByName": {}
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "call_index",
                "destinationType": "number"
              }
            ],
            "fields": {}
          }
        }
      ],
      "options": {
        "xField": "call_index",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "showValue": "never",
        "stacking": "normal",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "axisLabel": "tokens",
            "axisWidth": 60
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "call_index"
            },
            "properties": [
              {
                "id": "custom.axisLabel",
                "value": "iteration"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT call_index, coalesce(model, 'unknown') AS model, sum(total_input_tokens + output_tokens) AS tokens FROM claude.v_call_detail WHERE session_id = ${session_id:sqlstring} AND ('${model:csv}' = '' OR model = ANY(string_to_array('${model:csv}', ','))) GROUP BY call_index, model ORDER BY call_index, model"
        }
      ]
    },
    {
      "id": 7,
      "title": "Cache-read % by call (iteration)",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "claude-analytics-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "options": {
        "xField": "call_index",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "showValue": "never"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "axisLabel": "cache-read %",
            "axisWidth": 60
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "call_index"
            },
            "properties": [
              {
                "id": "custom.axisLabel",
                "value": "iteration"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT e.call_index, e.cache_read_pct FROM claude.v_call_cache_efficiency e WHERE e.session_id = ${session_id:sqlstring} AND ('${model:csv}' = '' OR e.call_index IN (SELECT call_index FROM claude.v_call_detail d WHERE d.session_id = e.session_id AND d.model = ANY(string_to_array('${model:csv}', ',')))) ORDER BY e.call_index"
        }
      ]
    },
    {
      "id": 13,
      "title": "Context growth by call (iteration)",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "claude-analytics-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "options": {
        "xField": "call_index",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "showValue": "never",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "axisLabel": "context growth (tokens)",
            "axisWidth": 70
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 500
              },
              {
                "color": "orange",
                "value": 2000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "call_index"
            },
            "properties": [
              {
                "id": "custom.axisLabel",
                "value": "iteration"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT e.call_index, e.context_growth_tokens FROM claude.v_call_cache_efficiency e WHERE e.session_id = ${session_id:sqlstring} AND ('${model:csv}' = '' OR e.call_index IN (SELECT call_index FROM claude.v_call_detail d WHERE d.session_id = e.session_id AND d.model = ANY(string_to_array('${model:csv}', ',')))) ORDER BY e.call_index"
        }
      ]
    },
    {
      "id": 12,
      "title": "Time between calls (s, by iteration)",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "claude-analytics-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "options": {
        "xField": "call_index",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "showValue": "never"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "axisLabel": "seconds since previous call",
            "axisWidth": 60
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 300
              },
              {
                "color": "dark-blue",
                "value": 3600
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "call_index"
            },
            "properties": [
              {
                "id": "custom.axisLabel",
                "value": "iteration"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT call_index, delta_seconds FROM claude.v_call_detail WHERE session_id = ${session_id:sqlstring} AND call_index > 1 AND ('${model:csv}' = '' OR model = ANY(string_to_array('${model:csv}', ','))) ORDER BY call_index"
        }
      ]
    },
    {
      "id": 8,
      "title": "Long gaps",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "claude-analytics-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT kind, call_index, called_at, delta_seconds FROM claude.v_long_gaps WHERE session_id = ${session_id:sqlstring} ORDER BY delta_seconds DESC"
        }
      ]
    },
    {
      "id": 9,
      "title": "Agent / subagent breakdown",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "claude-analytics-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT agent, agent_type, depth, parent_agent, sum(total_input_tokens + output_tokens) AS tokens, count(*) AS calls FROM claude.v_call_detail WHERE session_id = ${session_id:sqlstring} AND ('${model:csv}' = '' OR model = ANY(string_to_array('${model:csv}', ','))) GROUP BY agent, agent_type, depth, parent_agent ORDER BY tokens DESC"
        }
      ]
    },
    {
      "id": 10,
      "title": "Model mix",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "claude-analytics-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 51
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT model, count(*) AS calls, sum(total_input_tokens + output_tokens) AS tokens FROM claude.v_call_detail WHERE session_id = ${session_id:sqlstring} AND ('${model:csv}' = '' OR model = ANY(string_to_array('${model:csv}', ','))) GROUP BY model ORDER BY tokens DESC"
        }
      ]
    }
  ]
}
