# Copy to .env and adjust. .env is git-ignored.

# --- Where the transcripts live (host path, bind-mounted read-only) ---------
# Must be absolute: docker-compose does not expand `~` or $HOME here.
CLAUDE_PROJECTS_DIR=/Users/CHANGE_ME/.claude/projects

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=claude
POSTGRES_PASSWORD=claude
POSTGRES_DB=claude_analytics
# Host-side port, published on 127.0.0.1 only; 55432 avoids clashing with a local PostgreSQL on 5432.
POSTGRES_PORT=55432
POSTGRES_HOST=localhost

# Used verbatim when set. Inside the app container docker-compose overrides this
# to point at the `postgres` service.
# DATABASE_URL=postgresql://claude:claude@localhost:55432/claude_analytics

# Read-only role used by `acp ask` (see sql/019_ask_reader_role.sql). Unset = owner role.
# The role is created with the placeholder password changeme_ask. After first init rotate it
# (ALTER ROLE ask_reader WITH PASSWORD '...'; see sql/019 for the owner/grafana roles too) and put the new secret in this URL; compose
# passes it through to the app container (host name `postgres` there, localhost here).
# ASK_DATABASE_URL=postgresql://ask_reader:changeme_ask@localhost:55432/claude_analytics

# --- `acp ask --llm` (opt-in, needs `uv sync --group llm` and ASK_DATABASE_URL above) ----
ANTHROPIC_API_KEY=
# ACP_ASK_LLM_MODEL=claude-opus-5-5

# --- Image build args -------------------------------------------------------
PG_MAJOR=17
PG_PARQUET_VERSION=0.5.1
PGRX_VERSION=0.16.0

# --- Grafana dashboard -------------------------------------------------------
# Host-side port for `make dashboard` / `make up-grafana`.
GRAFANA_PORT=3000
# Password for the read-only grafana_reader DB role (see sql/007_grafana_role.sql).
GRAFANA_DB_PASSWORD=changeme_grafana

# --- Paths ------------------------------------------------------------------
# DATA_DIR=./data
# CSV_DIR=./data/csv
# PARQUET_DIR=./data/parquet
# NLP_EMBEDDINGS_CACHE_DIR=./data/nlp_cache
# Where the *server* sees the parquet bind mount.
PARQUET_DIR_IN_DB=/parquet
