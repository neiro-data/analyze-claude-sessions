# Copy to .env and adjust. .env is git-ignored.

# --- Where the transcripts live (host path, bind-mounted read-only) ---------
# Must be absolute: docker-compose does not expand `~` or $HOME here.
CLAUDE_PROJECTS_DIR=/Users/CHANGE_ME/.claude/projects

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=claude
POSTGRES_PASSWORD=claude
POSTGRES_DB=claude_analytics
# Host-side port; 55432 avoids clashing with a local PostgreSQL on 5432.
POSTGRES_PORT=55432
POSTGRES_HOST=localhost

# Used verbatim when set. Inside the app container docker-compose overrides this
# to point at the `postgres` service.
# DATABASE_URL=postgresql://claude:claude@localhost:55432/claude_analytics

# --- Image build args -------------------------------------------------------
PG_MAJOR=17
PG_PARQUET_VERSION=0.5.1
PGRX_VERSION=0.16.0

# --- Paths ------------------------------------------------------------------
# DATA_DIR=./data
# CSV_DIR=./data/csv
# PARQUET_DIR=./data/parquet
# Where the *server* sees the parquet bind mount.
PARQUET_DIR_IN_DB=/parquet
